#!/usr/bin/python3
# omarchy:summary=Clear the clipboard only if it still holds a stored secret
# omarchy:group=secrets
# omarchy:args=<service> <account>
"""Clear the clipboard when it still contains the addressed secret.

Compares the current clipboard contents to the secret stored for the
service/account pair and clears only on an exact match, so a timed clear can
never erase something the user copied afterward. The secret value is never
printed or stored outside the keyring.
"""

import subprocess
import sys

try:
    import gi

    gi.require_version("Secret", "1")
    from gi.repository import GLib, Secret
except (ImportError, ValueError):
    sys.exit("error: python-gobject is required (pacman -S python-gobject)")

SCHEMA = Secret.Schema.new(
    "org.freedesktop.Secret.Generic",
    Secret.SchemaFlags.DONT_MATCH_NAME,
    {"service": Secret.SchemaAttributeType.STRING, "account": Secret.SchemaAttributeType.STRING},
)


def main():
    if len(sys.argv) != 3:
        sys.exit("Usage: omarchy-secrets-clipclear <service> <account>")
    service, account = sys.argv[1], sys.argv[2]

    try:
        secret = Secret.password_lookup_sync(
            SCHEMA, {"service": service, "account": account}, None
        )
    except GLib.Error as e:
        sys.exit(f"error: {e.message}")
    if secret is None:
        sys.exit(f"error: no secret stored for {service} / {account}")

    try:
        current = subprocess.run(
            ["wl-paste", "-n"], capture_output=True, timeout=5, check=False
        )
    except (OSError, subprocess.TimeoutExpired) as e:
        sys.exit(f"error: wl-paste failed: {e}")
    if current.returncode != 0:
        return
    if current.stdout.decode("utf-8", errors="replace") != secret:
        return

    try:
        cleared = subprocess.run(
            ["wl-copy", "--clear"], capture_output=True, timeout=5, check=False
        )
    except (OSError, subprocess.TimeoutExpired) as e:
        sys.exit(f"error: wl-copy failed: {e}")
    if cleared.returncode != 0:
        sys.exit("error: wl-copy --clear failed")
    print(f"cleared clipboard for {service} / {account}", file=sys.stderr)


if __name__ == "__main__":
    main()
