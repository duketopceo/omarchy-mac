#!/usr/bin/python3
# omarchy:summary=Store a secret, reading the value from stdin
# omarchy:group=secrets
# omarchy:args=<service> <account>
"""Store a secret in the default Secret Service keyring.

The value is read from stdin to EOF so it never appears in process arguments
(unlike `secret-tool store`, piped input is not truncated at 8KB). An item
already addressed by the same service/account pair is updated in place,
preserving its existing attributes; a new item is created otherwise.
"""

import sys

try:
    import gi

    gi.require_version("Secret", "1")
    from gi.repository import GLib, Secret
except (ImportError, ValueError):
    sys.exit("error: python-gobject is required (pacman -S python-gobject)")

# Search schema never filters by name so existing items written by other tools
# are found; the store schema stamps new items with its name as provenance.
SEARCH_SCHEMA = Secret.Schema.new(
    "org.freedesktop.Secret.Generic",
    Secret.SchemaFlags.DONT_MATCH_NAME,
    {"service": Secret.SchemaAttributeType.STRING, "account": Secret.SchemaAttributeType.STRING},
)
STORE_SCHEMA = Secret.Schema.new(
    "org.omarchy.Secrets",
    Secret.SchemaFlags.NONE,
    {"service": Secret.SchemaAttributeType.STRING, "account": Secret.SchemaAttributeType.STRING},
)
FLAGS = Secret.SearchFlags.ALL | Secret.SearchFlags.UNLOCK


def main():
    if len(sys.argv) != 3:
        sys.exit("Usage: omarchy-secrets-set <service> <account>")
    service, account = sys.argv[1], sys.argv[2]

    try:
        secret = sys.stdin.read()
    except UnicodeDecodeError:
        sys.exit("error: secret must be UTF-8 text")
    if not secret:
        sys.exit("error: empty secret on stdin")

    try:
        svc = Secret.Service.get_sync(Secret.ServiceFlags.NONE, None)
        attrs = {"service": service, "account": account}
        matches = Secret.Service.search_sync(svc, SEARCH_SCHEMA, attrs, FLAGS, None) or []
        if len(matches) > 1:
            sys.exit(
                f"error: {len(matches)} items match {service} / {account}; refusing to pick one"
            )
        if matches:
            matches[0].set_secret_sync(Secret.Value.new(secret, -1, "text/plain"), None)
            print(f"updated {service} / {account}", file=sys.stderr)
        else:
            Secret.password_store_sync(
                STORE_SCHEMA,
                attrs,
                Secret.COLLECTION_DEFAULT,
                f"Omarchy: {service} / {account}",
                secret,
                None,
            )
            print(f"created {service} / {account}", file=sys.stderr)
    except GLib.Error as e:
        sys.exit(f"error: {e.message}")


if __name__ == "__main__":
    main()
