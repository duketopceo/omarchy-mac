#!/usr/bin/python3
# omarchy:summary=Delete a stored secret
# omarchy:group=secrets
# omarchy:args=<service> <account>
"""Delete a secret from the default Secret Service keyring.

Refuses to act when more than one item matches the service/account pair
rather than risk deleting another application's credential, and verifies the
item is actually gone afterward (a locked keyring can make removal silently
no-op).
"""

import sys

try:
    import gi

    gi.require_version("Secret", "1")
    from gi.repository import GLib, Secret
except (ImportError, ValueError):
    sys.exit("error: python-gobject is required (pacman -S python-gobject)")

# DONT_MATCH_NAME keeps matching on the service/account attributes only, so
# items written by other tools (omaseal, keytar, seahorse) are still found.
SCHEMA = Secret.Schema.new(
    "org.freedesktop.Secret.Generic",
    Secret.SchemaFlags.DONT_MATCH_NAME,
    {"service": Secret.SchemaAttributeType.STRING, "account": Secret.SchemaAttributeType.STRING},
)
FLAGS = Secret.SearchFlags.ALL | Secret.SearchFlags.UNLOCK


def main():
    if len(sys.argv) != 3:
        sys.exit("Usage: omarchy-secrets-delete <service> <account>")
    service, account = sys.argv[1], sys.argv[2]

    try:
        svc = Secret.Service.get_sync(Secret.ServiceFlags.NONE, None)
        attrs = {"service": service, "account": account}
        matches = Secret.Service.search_sync(svc, SCHEMA, attrs, FLAGS, None) or []
        if not matches:
            sys.exit(f"error: no secret stored for {service} / {account}")
        if len(matches) > 1:
            sys.exit(
                f"error: {len(matches)} items match {service} / {account}; refusing to delete"
            )
        matches[0].delete_sync(None)
        remaining = Secret.Service.search_sync(svc, SCHEMA, attrs, FLAGS, None) or []
        if remaining:
            sys.exit("error: delete did not take effect (keyring locked?)")
        print(f"deleted {service} / {account}", file=sys.stderr)
    except GLib.Error as e:
        sys.exit(f"error: {e.message}")


if __name__ == "__main__":
    main()
